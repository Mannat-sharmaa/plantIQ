# PlantIQ Environment Configuration Example
# Copy this file to .env and customize values for production deployment

# Application Mode
DEMO_MODE=true
DEBUG=true

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=plantiq_db

# Security & JWT Authentication
JWT_SECRET=plantiq_super_secret_jwt_key_2026_academic_defense
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Weather Telemetry Service (demo | openweather | weatherapi)
WEATHER_PROVIDER=demo
WEATHER_API_KEY=

# Generative AI & RAG Provider (demo | openai | gemini | claude | ollama)
AI_PROVIDER=demo
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Image Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_API_KEY=
STORAGE_SECRET=
